# Capacitor / device builds — set before `npm run build` + `cap sync`
#
# Physical phone (same Wi‑Fi): your PC LAN IP, e.g.
# VITE_API_BASE_URL=http://192.168.1.24:8090
#
# Android emulator:
# VITE_API_BASE_URL=http://10.0.2.2:8090
#
# Browser npm run dev: leave empty (proxy to localhost:8090)
VITE_API_BASE_URL=http://192.168.1.24:8090
